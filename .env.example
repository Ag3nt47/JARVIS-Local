# Jarvis is local-only by default.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_DATA_DIR=./data

# Existing local Ollama service and installed models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CONTEXT_WINDOW=8192

# Optional: set a private random value to key audit-chain signatures.
# JARVIS_AUDIT_SECRET=

# Optional desktop paths.
# JARVIS_BRAIN_ROOT=F:\BRAIN DRIVE\_root
# JARVIS_WORKSPACE_ROOT=C:\Users\you\Documents\JARVIS Workspace
# JARVIS_SOURCE_ROOT=D:\J.A.R.V.I.S\Source

# Optional Ed25519 federation seed: canonical unpadded base64url for exactly 32 bytes.
# JARVIS_FEDERATION_PRIVATE_KEY=
# JARVIS_FEDERATION_ENABLED=false
# JARVIS_FEDERATION_NODE_ID=windows.node
# JARVIS_FEDERATION_PEERS=[]
# JARVIS_FEDERATION_ROOTS={}

# Optional advanced communications credential overrides. The Windows setup center
# can instead protect write-only values with current-user DPAPI.
# JARVIS_TELEGRAM_BOT_TOKEN=
# JARVIS_DISCORD_WEBHOOK_URL=
# JARVIS_DISCORD_BOT_TOKEN=
# JARVIS_WEB_ROUTE_TOKEN=

# Optional Angerona read-only MCP connection. Keep the bearer token out of files.
# ANGERONA_ROOT=D:\local-security-ai\AngeronaSuite
# ANGERONA_MCP_PORT=47923
# ANGERONA_MCP_TOKEN=
# ANGERONA_WINDOW_TITLE=Angerona

# Optional inbound phone voice gateway. The API stays on loopback; expose only
# /api/phone/* through an operator-managed HTTPS reverse proxy. Generate a
# PBKDF2 PIN record with jarvis.phone_voice.hash_phone_pin in a trusted console.
# JARVIS_PHONE_ENABLED=false
# JARVIS_PHONE_PUBLIC_BASE_URL=https://jarvis-phone.example.com
# TWILIO_AUTH_TOKEN=
# JARVIS_PHONE_ALLOWED_CALLERS=+15551234567
# JARVIS_PHONE_PIN_HASH=pbkdf2_sha256$310000$...
